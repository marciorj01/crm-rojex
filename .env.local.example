# Copie para .env.local e preencha com o NOVO projeto. Nunca envie .env.local ao Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas servidor. Nunca usar prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo aleatório de pelo menos 32 caracteres; necessário apenas para webhook.
LEAD_WEBHOOK_SECRET=
# Contato público do feed (telefone no formato internacional +55DDDNUMERO).
FEED_CONTACT_NAME=
FEED_CONTACT_EMAIL=
FEED_CONTACT_PHONE=
FEED_CONTACT_WEBSITE=
